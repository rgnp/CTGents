#!/bin/sh
# CTGents 提交轻闸：只做快速 lint（ruff），不做 pytest（太重）。
# pytest 按设计不进提交门——质量靠"人跑测试 / 评审"兜底；gate_audit 事后只核对
# 本 ruff 门跑过没（不核 pytest）。别再说"pytest 由别处补位"，没有那个别处。
set -e

record_gate_pass() {
    git write-tree >> "$(git rev-parse --git-dir)/ctg-gate-passed" 2>/dev/null || true
}

staged_py=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.py$' || true)

# 找 python
PY=""
for candidate in python py python3; do
    if command -v "$candidate" >/dev/null 2>&1; then
        PY="$candidate"
        break
    fi
done
if [ -z "$PY" ]; then
    echo "[pre-commit] python not found"
    exit 1
fi

# 密钥扫描：检查整个暂存树，而不是工作区文件，也不局限于 Python。
if git grep --cached -nE \
    'sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9_]{30,}|BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY' \
    -- . ':!scripts/git-hooks/pre-commit' 2>/dev/null; then
    echo "[pre-commit] suspected secret key detected"
    exit 1
fi

# ruff（快速，~2s）
if [ -n "$staged_py" ] && ! $PY -m ruff check src/ tests/; then
    echo "[pre-commit] ruff failed"
    exit 1
fi

record_gate_pass
echo "[pre-commit] lint passed"
exit 0
