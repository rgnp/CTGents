#!/bin/sh
# CTGents 提交轻闸：只做快速 lint（ruff），不做 pytest（太重）。
# pytest 质量由 git_commit 工具内联 + gate_audit 事后审计补位。
set -e

record_gate_pass() {
    git write-tree >> "$(git rev-parse --git-dir)/ctg-gate-passed" 2>/dev/null || true
}

staged_py=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.py$' || true)
if [ -z "$staged_py" ]; then
    record_gate_pass
    exit 0
fi

# 找 python
PY=""
for candidate in python py python3; do
    if command -v "$candidate" >/dev/null 2>&1; then
        PY="$candidate"
        break
    fi
done
if [ -z "$PY" ]; then
    echo "[pre-commit] python not found"
    exit 1
fi

# 密钥扫描
if echo "$staged_py" | xargs grep -nE 'sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{30,}' 2>/dev/null; then
    echo "[pre-commit] suspected secret key detected"
    exit 1
fi

# ruff（快速，~2s）
if ! $PY -m ruff check src/ tests/; then
    echo "[pre-commit] ruff failed"
    exit 1
fi

record_gate_pass
echo "[pre-commit] lint passed"
exit 0
